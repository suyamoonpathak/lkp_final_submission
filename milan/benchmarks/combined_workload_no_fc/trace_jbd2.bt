#!/usr/bin/env bpftrace
//
// trace_jbd2.bt
//
// Traces JBD2 journal activity during the combined benchmark.
// Attaches to all 21 available JBD2 kernel tracepoints and emits structured
// KEY=VALUE output when killed (triggering the END block).
//
// Usage (called by run_combined_analysis.sh -- do not run directly):
//   sudo bpftrace trace_jbd2.bt > jbd2_trace_<workload>_<mode>.txt 2>&1 &
//
// Every probe filters on args.dev == @target_dev (major=259, minor=6,
// i.e. /dev/nvme0n1p6) so that root-fs and any other ext4 journal activity
// is excluded entirely. The dev_t value is set in BEGIN and stored in
// @target_dev. In nojournal mode JBD2 is disabled; bpftrace attaches but
// the filter never matches so all counters remain zero.
//
// Output is wrapped in sentinel lines so the Python parser can extract it
// cleanly even if bpftrace prints startup messages above the END block:
//   --- JBD2_TRACE_RESULTS_BEGIN ---
//   KEY=VALUE
//   ...
//   --- JBD2_TRACE_RESULTS_END ---

BEGIN
{
    @benchmark_start_ns = nsecs;

    // dev_t of the benchmarked partition (/dev/nvme0n1p6).
    // Encoded as (MAJOR << 20) | MINOR on 64-bit Linux.
    // major=259 (nvme), minor=6 (p6) → (259 << 20) | 6 = 271581190.
    // Every probe filters on args.dev == @target_dev so that root-fs
    // and any other ext4 journal activity is excluded entirely.
    @target_dev = (uint64)271581190;
}

// ── Commit pipeline: wall-clock timing ───────────────────────────────────────
// A complete commit cycle fires in this order:
//   jbd2_start_commit → jbd2_commit_locking → jbd2_commit_flushing
//   → jbd2_commit_logging → jbd2_end_commit
// We timestamp each transition to measure per-stage duration.
// All probes filter args.dev == @target_dev to exclude other filesystems.

tracepoint:jbd2:jbd2_start_commit
/ args.dev == @target_dev /
{
    @commit_count++;
    @commit_start[args.transaction] = nsecs;
}

tracepoint:jbd2:jbd2_commit_locking
/ args.dev == @target_dev /
{
    @commit_locking_count++;
    @locking_start[args.transaction] = nsecs;
}

tracepoint:jbd2:jbd2_commit_flushing
/ args.dev == @target_dev /
{
    @commit_flushing_count++;
    if (@locking_start[args.transaction]) {
        $us = (nsecs - @locking_start[args.transaction]) / 1000;
        @locking_total_us += $us;
        delete(@locking_start[args.transaction]);
    }
    @flushing_start[args.transaction] = nsecs;
}

tracepoint:jbd2:jbd2_commit_logging
/ args.dev == @target_dev /
{
    @commit_logging_count++;
    if (@flushing_start[args.transaction]) {
        $us = (nsecs - @flushing_start[args.transaction]) / 1000;
        @flushing_total_us += $us;
        delete(@flushing_start[args.transaction]);
    }
    @logging_start[args.transaction] = nsecs;
}

tracepoint:jbd2:jbd2_end_commit
/ args.dev == @target_dev /
{
    @end_commit_count++;
    // End-to-end commit latency (start_commit → end_commit)
    if (@commit_start[args.transaction]) {
        $us = (nsecs - @commit_start[args.transaction]) / 1000;
        @commit_total_us += $us;
        delete(@commit_start[args.transaction]);
    }
    // Logging phase duration (commit_logging → end_commit)
    if (@logging_start[args.transaction]) {
        $us = (nsecs - @logging_start[args.transaction]) / 1000;
        @logging_total_us += $us;
        delete(@logging_start[args.transaction]);
    }
}

// ── jbd2_run_stats: kernel-computed per-transaction breakdown ─────────────────
// Fires once per committed transaction. Timing fields are in jiffies
// (= milliseconds at HZ=1000). Provides the most accurate pipeline breakdown
// because the kernel measures each phase internally without probe overhead.

tracepoint:jbd2:jbd2_run_stats
/ args.dev == @target_dev /
{
    @run_stats_count++;
    @run_stats_sum_wait_ms      += args.wait;
    @run_stats_sum_reqdelay_ms  += args.request_delay;
    @run_stats_sum_running_ms   += args.running;
    @run_stats_sum_locked_ms    += args.locked;
    @run_stats_sum_flushing_ms  += args.flushing;
    @run_stats_sum_logging_ms   += args.logging;
    @run_stats_sum_handles      += args.handle_count;
    @run_stats_sum_blocks       += args.blocks;
    @run_stats_sum_blocks_logged += args.blocks_logged;
}

// ── Checkpoint activity ───────────────────────────────────────────────────────
// Checkpointing writes journal blocks to their final on-disk locations,
// freeing journal space for reuse. jbd2_checkpoint fires per checkpoint call;
// jbd2_checkpoint_stats fires once per completed checkpoint sequence.

tracepoint:jbd2:jbd2_checkpoint
/ args.dev == @target_dev /
{
    @checkpoint_count++;
    @chkpt_start_ns = nsecs;
}

tracepoint:jbd2:jbd2_checkpoint_stats
/ args.dev == @target_dev /
{
    @checkpoint_stats_count++;
    @chkpt_sum_time_ms += args.chp_time;
    @chkpt_sum_written += args.written;
    @chkpt_sum_dropped += args.dropped;
    // Track inter-checkpoint interval: time between consecutive checkpoint_stats
    if (@last_chkpt_ns > 0) {
        $interval_ms = (nsecs - @last_chkpt_ns) / 1000000;
        @chkpt_sum_interval_ms += $interval_ms;
        @chkpt_interval_count++;
        if ($interval_ms < @chkpt_min_interval_ms || @chkpt_min_interval_ms == 0) {
            @chkpt_min_interval_ms = $interval_ms;
        }
        if ($interval_ms > @chkpt_max_interval_ms) {
            @chkpt_max_interval_ms = $interval_ms;
        }
    }
    @last_chkpt_ns = nsecs;
}

// ── Journal space pressure ────────────────────────────────────────────────────
// jbd2_update_log_tail fires each time the journal tail advances (i.e. after a
// checkpoint frees space). Track how frequently this happens and how many blocks
// are freed per tail advance -- sparse tail advances with small freed counts
// indicate the journal is under sustained pressure.

tracepoint:jbd2:jbd2_update_log_tail
/ args.dev == @target_dev /
{
    @update_log_tail_count++;
    @log_tail_sum_freed += args.freed;
    // Count tail updates that freed fewer than 8 blocks -- indicates trickle
    // checkpointing under heavy pressure where journal is nearly full.
    if (args.freed < 8) {
        @log_tail_small_free_count++;
    }
}

// ── Handle lifecycle ──────────────────────────────────────────────────────────
// A journal handle is the per-operation token that ext4 holds for the
// duration of a single atomic filesystem operation (e.g. one write()).
// handle_start fires when a handle is opened; handle_stats fires when closed.

tracepoint:jbd2:jbd2_handle_start
/ args.dev == @target_dev /
{
    @handle_start_count++;
}

tracepoint:jbd2:jbd2_handle_stats
/ args.dev == @target_dev /
{
    @handle_stats_count++;
    @handle_sum_dirtied += (uint64)args.dirtied_blocks;
    if (args.sync) {
        @handle_sync_count++;
    }
}

tracepoint:jbd2:jbd2_handle_extend
/ args.dev == @target_dev /
{
    @handle_extend_count++;
}

tracepoint:jbd2:jbd2_handle_restart
/ args.dev == @target_dev /
{
    @handle_restart_count++;
}

// ── Data block submission (journal mode only) ─────────────────────────────────
// Fires when ext4 submits inode data blocks to the journal (data=journal only).
// Count should match IOPS in journal mode; zero in ordered/writeback/nojournal.

tracepoint:jbd2:jbd2_submit_inode_data
/ args.dev == @target_dev /
{
    @submit_inode_data_count++;
}

// ── Journal maintenance ───────────────────────────────────────────────────────

tracepoint:jbd2:jbd2_write_superblock
/ args.dev == @target_dev /
{
    @write_superblock_count++;
}

tracepoint:jbd2:jbd2_lock_buffer_stall
/ args.dev == @target_dev /
{
    @lock_buffer_stall_count++;
    @lock_buffer_stall_total_ms += args.stall_ms;
}

// ── END: emit all results as structured KEY=VALUE lines ──────────────────────
// The Python parser in analyse_combined_results.py reads everything between the
// sentinel lines and converts each KEY=VALUE pair to an integer.
// All per-transaction correlation maps are explicitly cleared here so
// bpftrace does not auto-print them in an unstructured format.

END
{
    $trace_us = (nsecs - @benchmark_start_ns) / 1000;

    printf("\n--- JBD2_TRACE_RESULTS_BEGIN ---\n");

    // ── Trace duration ──────────────────────────────────────────────────────
    printf("TRACE_DURATION_US=%llu\n", $trace_us);

    // ── Commit pipeline counts ──────────────────────────────────────────────
    printf("COMMIT_COUNT=%llu\n",          @commit_count);
    printf("LOCKING_COUNT=%llu\n",         @commit_locking_count);
    printf("FLUSHING_COUNT=%llu\n",        @commit_flushing_count);
    printf("LOGGING_COUNT=%llu\n",         @commit_logging_count);
    printf("END_COMMIT_COUNT=%llu\n",      @end_commit_count);

    // ── Commit pipeline timing (microseconds, from bpftrace timestamps) ─────
    printf("COMMIT_TOTAL_US=%llu\n",       @commit_total_us);
    printf("LOCKING_TOTAL_US=%llu\n",      @locking_total_us);
    printf("FLUSHING_TOTAL_US=%llu\n",     @flushing_total_us);
    printf("LOGGING_TOTAL_US=%llu\n",      @logging_total_us);

    // ── jbd2_run_stats aggregates (timing in jiffies = ms at HZ=1000) ───────
    printf("RUN_STATS_COUNT=%llu\n",              @run_stats_count);
    printf("RUN_STATS_SUM_WAIT_MS=%llu\n",         @run_stats_sum_wait_ms);
    printf("RUN_STATS_SUM_REQDELAY_MS=%llu\n",     @run_stats_sum_reqdelay_ms);
    printf("RUN_STATS_SUM_RUNNING_MS=%llu\n",      @run_stats_sum_running_ms);
    printf("RUN_STATS_SUM_LOCKED_MS=%llu\n",       @run_stats_sum_locked_ms);
    printf("RUN_STATS_SUM_FLUSHING_MS=%llu\n",     @run_stats_sum_flushing_ms);
    printf("RUN_STATS_SUM_LOGGING_MS=%llu\n",      @run_stats_sum_logging_ms);
    printf("RUN_STATS_SUM_HANDLES=%llu\n",          @run_stats_sum_handles);
    printf("RUN_STATS_SUM_BLOCKS=%llu\n",           @run_stats_sum_blocks);
    printf("RUN_STATS_SUM_BLOCKS_LOGGED=%llu\n",    @run_stats_sum_blocks_logged);

    // ── Checkpoint ──────────────────────────────────────────────────────────
    printf("CHECKPOINT_COUNT=%llu\n",            @checkpoint_count);
    printf("CHECKPOINT_STATS_COUNT=%llu\n",      @checkpoint_stats_count);
    printf("CHKPT_SUM_TIME_MS=%llu\n",           @chkpt_sum_time_ms);
    printf("CHKPT_SUM_WRITTEN=%llu\n",           @chkpt_sum_written);
    printf("CHKPT_SUM_DROPPED=%llu\n",           @chkpt_sum_dropped);
    printf("CHKPT_SUM_INTERVAL_MS=%llu\n",       @chkpt_sum_interval_ms);
    printf("CHKPT_INTERVAL_COUNT=%llu\n",        @chkpt_interval_count);
    printf("CHKPT_MIN_INTERVAL_MS=%llu\n",       @chkpt_min_interval_ms);
    printf("CHKPT_MAX_INTERVAL_MS=%llu\n",       @chkpt_max_interval_ms);
    printf("LOG_TAIL_SMALL_FREE_COUNT=%llu\n",   @log_tail_small_free_count);

    // ── Handle activity ─────────────────────────────────────────────────────
    printf("HANDLE_START_COUNT=%llu\n",     @handle_start_count);
    printf("HANDLE_STATS_COUNT=%llu\n",     @handle_stats_count);
    printf("HANDLE_SYNC_COUNT=%llu\n",      @handle_sync_count);
    printf("HANDLE_EXTEND_COUNT=%llu\n",    @handle_extend_count);
    printf("HANDLE_RESTART_COUNT=%llu\n",   @handle_restart_count);
    printf("HANDLE_SUM_DIRTIED=%llu\n",     @handle_sum_dirtied);

    // ── Journal maintenance ──────────────────────────────────────────────────
    printf("UPDATE_LOG_TAIL_COUNT=%llu\n",      @update_log_tail_count);
    printf("LOG_TAIL_SUM_FREED=%llu\n",          @log_tail_sum_freed);
    printf("WRITE_SUPERBLOCK_COUNT=%llu\n",      @write_superblock_count);
    printf("SUBMIT_INODE_DATA_COUNT=%llu\n",     @submit_inode_data_count);
    printf("LOCK_BUFFER_STALL_COUNT=%llu\n",     @lock_buffer_stall_count);
    printf("LOCK_BUFFER_STALL_TOTAL_MS=%llu\n",  @lock_buffer_stall_total_ms);

    printf("--- JBD2_TRACE_RESULTS_END ---\n");

    // Explicitly clear all maps so bpftrace does not auto-print them in
    // an unstructured format after the sentinel block above.
    clear(@commit_start);
    clear(@locking_start);
    clear(@flushing_start);
    clear(@logging_start);

    // Clear all accumulator maps
    @benchmark_start_ns = 0;
    @target_dev = 0;
    @commit_count = 0;
    @commit_locking_count = 0;
    @commit_flushing_count = 0;
    @commit_logging_count = 0;
    @end_commit_count = 0;
    @commit_total_us = 0;
    @locking_total_us = 0;
    @flushing_total_us = 0;
    @logging_total_us = 0;
    @run_stats_count = 0;
    @run_stats_sum_wait_ms = 0;
    @run_stats_sum_reqdelay_ms = 0;
    @run_stats_sum_running_ms = 0;
    @run_stats_sum_locked_ms = 0;
    @run_stats_sum_flushing_ms = 0;
    @run_stats_sum_logging_ms = 0;
    @run_stats_sum_handles = 0;
    @run_stats_sum_blocks = 0;
    @run_stats_sum_blocks_logged = 0;
    @checkpoint_count = 0;
    @checkpoint_stats_count = 0;
    @chkpt_sum_time_ms = 0;
    @chkpt_sum_written = 0;
    @chkpt_sum_dropped = 0;
    @chkpt_sum_interval_ms = 0;
    @chkpt_interval_count = 0;
    @chkpt_min_interval_ms = 0;
    @chkpt_max_interval_ms = 0;
    @last_chkpt_ns = 0;
    @chkpt_start_ns = 0;
    @log_tail_small_free_count = 0;
    @handle_start_count = 0;
    @handle_stats_count = 0;
    @handle_sync_count = 0;
    @handle_extend_count = 0;
    @handle_restart_count = 0;
    @handle_sum_dirtied = 0;
    @update_log_tail_count = 0;
    @log_tail_sum_freed = 0;
    @write_superblock_count = 0;
    @submit_inode_data_count = 0;
    @lock_buffer_stall_count = 0;
    @lock_buffer_stall_total_ms = 0;
}
