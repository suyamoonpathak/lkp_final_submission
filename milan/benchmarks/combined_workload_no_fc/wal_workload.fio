# wal_workload.fio
# Simulates a Write-Ahead Log (WAL) workload -- the most journal-intensive
# I/O pattern possible. Every write is immediately forced to disk with
# fsync(), which flushes data and data-retrieval metadata to disk,
# replicating the durability guarantee of database transaction commits
# (this is the exact syscall PostgreSQL and MySQL use for WAL durability).
#
# Do NOT run this directly -- it is called by run_combined_analysis.sh

[global]
# ── Where fio writes its test files ──────────────────────────────────────────
# Overridden by the calling script using --directory=
directory=/media/milan-roy/test_ext4

# ── Duration control ──────────────────────────────────────────────────────────
# time_based=1 + runtime: run for a fixed wall-clock duration so this job
# runs for the exact same window as seq_write.fio, keeping contention fair.
time_based=1
runtime=120

# ── Concurrency ───────────────────────────────────────────────────────────────
numjobs=1

# ── Output ────────────────────────────────────────────────────────────────────
# group_reporting=1 in [global] aggregates all numjobs workers into a single
# result block in the JSON, giving exactly one entry per fio invocation.
group_reporting=1

# ── I/O submission ────────────────────────────────────────────────────────────
ioengine=sync
direct=0
buffered=1
lat_percentiles=1
iodepth=1

[wal-simulation]
# ── I/O pattern ───────────────────────────────────────────────────────────────
# rw=write: sequential writes, always moving forward through the file.
rw=write

# ── Block size ────────────────────────────────────────────────────────────────
# bs=8k: each individual write is exactly 8 kilobytes.
bs=8k

# ── Loop file size ────────────────────────────────────────────────────────────
# size=1g: fio creates a 1GB file per job and loops over it for the runtime.
# 1g × 4 jobs = 4GB total allocation for this section.
size=1g

# ── Filename ──────────────────────────────────────────────────────────────────
# Explicit prefix keeps WAL test files separate from seq test files so the
# two concurrent fio processes do not collide on the same filenames.
filename_format=wal.$jobnum

# ── The single most important parameter for this workload ─────────────────────
# fsync=1: call fsync() after EVERY single write.
# Forces a full journal commit per write -- the worst-case scenario for
# journaling overhead and exactly what makes WAL workloads so revealing
# about journal commit performance.
fsync=1
