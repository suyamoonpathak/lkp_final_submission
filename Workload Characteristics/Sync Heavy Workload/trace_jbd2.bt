#!/usr/bin/env bpftrace
//
// trace_jbd2.bt
//
// Traces JBD2 journal activity during the sync-heavy benchmark.
// Emits structured KEY=VALUE output when killed (END block).
//
// Usage (called by run_analysis.sh -- do not run directly):
//   sudo bpftrace trace_jbd2.bt <dev_t> > jbd2_trace_<mode>.txt 2>&1 &
//
// <dev_t> = (MAJOR << 20) | MINOR, computed in run_analysis.sh.
// Every probe filters args.dev == @target_dev to exclude root-fs activity.

BEGIN
{
    @benchmark_start_ns = nsecs;
    @target_dev = (uint64)$1;
}

// Capture the first dev value seen (any filesystem) for diagnostics
tracepoint:jbd2:jbd2_start_commit
/ @first_dev_seen == 0 /
{
    @first_dev_seen = (uint64)args.dev;
}

// Total transactions and end-to-end commit timing
tracepoint:jbd2:jbd2_start_commit
/ args.dev == @target_dev /
{
    @commit_count++;
    @commit_start[args.transaction] = nsecs;
}

tracepoint:jbd2:jbd2_commit_logging
/ args.dev == @target_dev /
{
    @commit_logging_count++;
    @logging_start[args.transaction] = nsecs;
}

tracepoint:jbd2:jbd2_end_commit
/ args.dev == @target_dev /
{
    if (@commit_start[args.transaction]) {
        $us = (nsecs - @commit_start[args.transaction]) / 1000;
        @commit_total_us += $us;
        delete(@commit_start[args.transaction]);
    }
    if (@logging_start[args.transaction]) {
        $us = (nsecs - @logging_start[args.transaction]) / 1000;
        @logging_total_us += $us;
        delete(@logging_start[args.transaction]);
    }
}

// Per-transaction block counts (blocks_logged used for Blks logged/txn)
tracepoint:jbd2:jbd2_run_stats
/ args.dev == @target_dev /
{
    @run_stats_count++;
    @run_stats_sum_blocks_logged += args.blocks_logged;
}

END
{
    $trace_us = (nsecs - @benchmark_start_ns) / 1000;

    printf("\n--- JBD2_TRACE_RESULTS_BEGIN ---\n");

    printf("TRACE_DURATION_US=%llu\n",           $trace_us);
    printf("TARGET_DEV=%llu\n",                  @target_dev);
    printf("FIRST_DEV_SEEN=%llu\n",              @first_dev_seen);
    printf("COMMIT_COUNT=%llu\n",                @commit_count);
    printf("LOGGING_COUNT=%llu\n",               @commit_logging_count);
    printf("COMMIT_TOTAL_US=%llu\n",             @commit_total_us);
    printf("LOGGING_TOTAL_US=%llu\n",            @logging_total_us);
    printf("RUN_STATS_COUNT=%llu\n",             @run_stats_count);
    printf("RUN_STATS_SUM_BLOCKS_LOGGED=%llu\n", @run_stats_sum_blocks_logged);

    printf("--- JBD2_TRACE_RESULTS_END ---\n");

    clear(@commit_start);
    clear(@logging_start);
}
